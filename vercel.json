{
  "functions": {
    "api/product-page.js": { "includeFiles": "dist/index.html", "maxDuration": 30 },
    "api/og.js": { "includeFiles": "social/fonts/**", "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/share/product/:id", "destination": "/product/:id", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/api/product-page?id=:id"
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
